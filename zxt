#!/usr/bin/env python3

import os
import sys
import subprocess
from pathlib import Path

UID = os.getuid()

BASE_DIR = Path(__file__).resolve().parent
PRESET = BASE_DIR / "presets" / "zxt-default.txt"

STATE_DIR = BASE_DIR / "state"
STATE_FILE = STATE_DIR / "disabled-services.txt"
PREVIOUS_PRESET = STATE_DIR / "previous-preset.txt"

BANNER = r"""
