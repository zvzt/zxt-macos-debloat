def run(cmd: list[str], quiet: bool = True) -> subprocess.CompletedProcess:
    kwargs = {
        "check": False,
        "text": True,
    }

    if quiet:
        kwargs["stdout"] = subprocess.DEVNULL
        kwargs["stderr"] = subprocess.DEVNULL

    return subprocess.run(cmd, **kwargs)


def privileged(
    cmd: list[str],
    quiet: bool = True,
) -> subprocess.CompletedProcess:
    if os.geteuid() == 0:
        return run(cmd, quiet=quiet)

    return run(
        ["sudo", *cmd],
        quiet=quiet,
    )


def read_labels(path: Path) -> list[str]:
    if not path.exists():
        return []

    labels: list[str] = []

    for raw in path.read_text(errors="ignore").splitlines():
        line = raw.split("#", 1)[0].strip()

        if line:
            labels.append(line)

    return list(dict.fromkeys(labels))


def preset_labels() -> list[str]:
    return read_labels(PRESET)


def user_domain() -> str:
    return f"gui/{UID}"


def registered(domain: str, label: str) -> bool:
    result = run(
        [
            "launchctl",
            "print",
            f"{domain}/{label}",
        ]
    )

    return result.returncode == 0


def direct_plist_kind(label: str) -> set[str]:
    kinds: set[str] = set()

    for directory in AGENT_DIRS:
        if (directory / f"{label}.plist").exists():
            kinds.add("user")

    for directory in DAEMON_DIRS:
        if (directory / f"{label}.plist").exists():
            kinds.add("system")

    return kinds


def domains_for(label: str) -> set[str]:
    domains: set[str] = set()

    if registered(user_domain(), label):
        domains.add("user")

    if registered("system", label):
        domains.add("system")

    if not domains:
        domains |= direct_plist_kind(label)

    return domains


def disable_user(label: str) -> bool:
    domain = user_domain()

    result = run(
        [
            "launchctl",
            "disable",
            f"{domain}/{label}",
        ]
    )

    run(
        [
            "launchctl",
            "bootout",
            f"{domain}/{label}",
        ]
    )

    return result.returncode == 0


def disable_system(label: str) -> bool:
    result = privileged(
        [
            "launchctl",
            "disable",
            f"system/{label}",
        ]
    )

    privileged(
        [
            "launchctl",
            "bootout",
            f"system/{label}",
        ]
    )

    return result.returncode == 0


def enable_user(label: str) -> None:
    run(
        [
            "launchctl",
            "enable",
            f"{user_domain()}/{label}",
        ]
    )


def enable_system(label: str) -> None:
    privileged(
        [
            "launchctl",
            "enable",
            f"system/{label}",
        ]
    )


def save_state(entries: set[str]) -> None:
    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    text = "\n".join(sorted(entries))

    if text:
        text += "\n"

    STATE_FILE.write_text(text)


def read_state() -> set[str]:
    if not STATE_FILE.exists():
        return set()

    return set(
        read_labels(STATE_FILE)
    )


def encode_state(kind: str, label: str) -> str:
    return f"{kind}|{label}"


def decode_state(entry: str) -> tuple[str | None, str]:
    if "|" not in entry:
        return None, entry

    kind, label = entry.split("|", 1)

    if kind not in {
        "user",
        "system",
    }:
        return None, entry

    return kind, label


def migration_labels() -> set[str]:
    if PREVIOUS_PRESET.exists():
        return set(
            read_labels(PREVIOUS_PRESET)
        )

    return set()


def restore_entry(entry: str) -> None:
    kind, label = decode_state(entry)

    if kind == "user":
        enable_user(label)
        return

    if kind == "system":
        enable_system(label)
        return

    domains = domains_for(label)

    if "user" in domains:
        enable_user(label)

    if "system" in domains:
        enable_system(label)

    if not domains:
        enable_user(label)
        enable_system(label)


def actual_disabled(
    domain: str,
    label: str,
) -> bool:
    result = subprocess.run(
        [
            "launchctl",
            "print-disabled",
            domain,
        ],
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        return False

    if not result.stdout:
        return False

    return (
        f'"{label}" => disabled'
        in result.stdout
    )


def apply(*, quiet: bool = False) -> None:
    if not PRESET.exists():
        print(
            f"Preset not found: {PRESET}"
        )
        sys.exit(1)

    desired = set(
        preset_labels()
    )

    previous_state = read_state()
    old_labels = migration_labels()

    previous_labels = {
        decode_state(entry)[1]
        for entry in previous_state
    }

    removed_labels = (
        previous_labels | old_labels
    ) - desired

    if removed_labels and not quiet:
        print(
            f"Restoring {len(removed_labels)} "
            "labels removed from the previous preset..."
        )

    for label in sorted(removed_labels):
        domains = domains_for(label)

        if "user" in domains:
            enable_user(label)

        if "system" in domains:
            enable_system(label)

        if not domains:
            enable_user(label)
            enable_system(label)

    managed: set[str] = set()
    unavailable: list[str] = []

    if not quiet:
        print(
            f"Applying ZXT preset "
            f"({len(desired)} labels)..."
        )

    for label in sorted(desired):
        domains = domains_for(label)

        if not domains:
            unavailable.append(label)
            continue

        if "user" in domains:
            disable_user(label)

            managed.add(
                encode_state(
                    "user",
                    label,
                )
            )

        if "system" in domains:
            disable_system(label)

            managed.add(
                encode_state(
                    "system",
                    label,
                )
            )

    save_state(managed)

    if PREVIOUS_PRESET.exists():
        try:
            PREVIOUS_PRESET.unlink()
        except OSError:
            pass

    if quiet:
        return

    print(BANNER)

    print(
        f"Preset labels: {len(desired)}"
    )

    print(
        f"Managed launchd targets: "
        f"{len(managed)}"
    )

    if removed_labels:
        print(
            f"Old labels restored: "
            f"{len(removed_labels)}"
        )

    if unavailable:
        print(
            f"Not present on this macOS build: "
            f"{len(unavailable)}"
        )

    print()
    print(
        "Spotlight indexing was left "
        "exactly as it was."
    )
    print(
        "Core schedulers, WindowServer, "
        "CoreSpotlight, CoreDuet,"
    )
    print(
        "Biome, GamePolicy, TCC, "
        "runningboardd and dasd are retained."
    )
    print()
    print(
        "Restart macOS once after "
        "the first install/update."
    )


def reapply(kind: str) -> None:
    desired = preset_labels()

    for label in desired:
        domains = domains_for(label)

        if kind not in domains:
            continue

        if kind == "user":
            disable_user(label)

        else:
            disable_system(label)


def restore() -> None:
    state = read_state()

    if not state:
        print(
            "No ZXT-managed state is recorded."
        )
        return

    print(
        f"Restoring {len(state)} "
        "ZXT-managed launchd targets..."
    )

    for entry in sorted(state):
        restore_entry(entry)

    save_state(set())

    print(BANNER)

    print(
        "ZXT-managed launchd overrides "
        "were re-enabled."
    )

    print(
        "Spotlight indexing was not changed."
    )

    print(
        "Restart macOS to allow services "
        "to return normally."
    )


def status() -> None:
    desired = preset_labels()

    user_disabled = 0
    system_disabled = 0
    present = 0

    for label in desired:
        domains = domains_for(label)

        if domains:
            present += 1

        if (
            "user" in domains
            and actual_disabled(
                user_domain(),
                label,
            )
        ):
            user_disabled += 1

        if (
            "system" in domains
            and actual_disabled(
                "system",
                label,
            )
        ):
            system_disabled += 1

    print(BANNER)

    print(
        f"Preset labels: {len(desired)}"
    )

    print(
        f"Present on this Mac: {present}"
    )

    print(
        f"User-domain disabled: "
        f"{user_disabled}"
    )

    print(
        f"System-domain disabled: "
        f"{system_disabled}"
    )

    print(
        f"Recorded ZXT targets: "
        f"{len(read_state())}"
    )

    print()
    print("Spotlight status:")

    subprocess.run(
        [
            "mdutil",
            "-as",
        ],
        check=False,
    )


def list_services() -> None:
    for label in preset_labels():
        domains = domains_for(label)

        if domains:
            where = ",".join(
                sorted(domains)
            )
        else:
            where = "not-present"

        print(
            f"{where:12} {label}"
        )


def usage() -> None:
    print(
        "Usage: zxt "
        "[apply|status|restore|list|"
        "reapply-user|reapply-system]"
    )


def main() -> None:
    if len(sys.argv) == 1:
        apply()
        return

    command = sys.argv[1].lower()

    quiet = (
        "--quiet"
        in sys.argv[2:]
    )

    if command in {
        "apply",
        "--apply",
    }:
        apply(
            quiet=quiet
        )

    elif command in {
        "restore",
        "--restore",
    }:
        restore()

    elif command in {
        "status",
        "--status",
    }:
        status()

    elif command in {
        "list",
        "--list",
    }:
        list_services()

    elif command == "reapply-user":
        reapply("user")

    elif command == "reapply-system":
        reapply("system")

    else:
        usage()
        sys.exit(1)


if __name__ == "__main__":
    main()
